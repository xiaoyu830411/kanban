# Copy to .env for local development (docker compose and drizzle-kit read this file).

# MySQL root password used by docker compose (must match DATABASE_URL below)
MYSQL_ROOT_PASSWORD=kanban

# App database connection (host port 3307 is mapped in docker-compose.yml to avoid
# clashing with any MySQL already running on the host's 3306)
DATABASE_URL=mysql://root:kanban@127.0.0.1:3307/kanban

# Vitest uses this database (same MySQL instance); schema is applied automatically
TEST_DATABASE_URL=mysql://root:kanban@127.0.0.1:3307/kanban_test

# Auth (filled in by T3/T11; dev login provider)
# AUTH_DEV_ENABLED=true
# HTTPS 部署时开启会话 cookie 的 Secure 标志（本地 HTTP 部署保持关闭）
# COOKIE_SECURE=true

# Feishu open platform credentials (T11) — see docs/agents/feishu-setup.md
# FEISHU_APP_ID=
# FEISHU_APP_SECRET=
# FEISHU_REDIRECT_URI=http://localhost:3000/api/auth/feishu/callback
